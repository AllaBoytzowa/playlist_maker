<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:padding="@dimen/main_layout_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:layout_marginBottom="24dp">

        <Button
            android:id="@+id/back_arrow_button"
            android:contentDescription="@string/back_arrow"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:backgroundTint="@color/white"
            app:icon="@drawable/light_mode_arrow_back"
            app:iconTint="@color/yp_black" />

        <TextView
            android:layout_width="wrap_content"
            android:textStyle="bold"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:text="@string/settings"
            android:textColor="@color/yp_black"
            android:textSize="@dimen/title_text_size"
            android:gravity="center_vertical"
            android:paddingStart="12dp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dark_theme"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black"
                android:textSize="16sp"/>

            <Switch
                android:layout_width="48dp"
                android:layout_height="match_parent"
                tools:ignore="UseSwitchCompatOrMaterialXml"
                android:layout_gravity="end"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/share_app"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black"
                android:textSize="16sp"/>

            <Button
                android:contentDescription="@string/share_app"
                app:icon="@drawable/light_mode_share"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@android:color/transparent"
                android:backgroundTint="@color/white"
                app:iconTint="@color/yp_gray"
                app:iconSize="@dimen/button_icon_size"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/write_support"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black"
                android:textSize="16sp"/>

            <Button
                android:contentDescription="@string/write_support"
                app:icon="@drawable/support"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@android:color/transparent"
                android:backgroundTint="@color/white"
                app:iconTint="@color/yp_gray"
                app:iconSize="@dimen/button_icon_size"/>
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/therms"
                android:layout_gravity="center_vertical"
                android:textColor="@color/black"
                android:textSize="16sp"/>

            <Button
                android:contentDescription="@string/therms"
                app:icon="@drawable/light_mode_arrow_forward"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:background="@android:color/transparent"
                android:backgroundTint="@color/white"
                app:iconTint="@color/yp_gray"
                app:iconSize="@dimen/button_icon_size"/>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>